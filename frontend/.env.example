# Frontend env. In dev, leave these unset to use the Vite proxy (/api + /runs).
# In production (Vercel), point them at your deployed FastAPI backend so the
# app and the streamed screenshots load cross-origin:
#   VITE_API_BASE=https://autoqa-api.example.com          # API calls
#   VITE_API_ORIGIN=https://autoqa-api.example.com        # screenshot <img> src prefix
VITE_API_BASE=/api
VITE_API_ORIGIN=
