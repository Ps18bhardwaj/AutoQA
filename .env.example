# ============================================================
#  AutoQA — environment variables (ALL FREE / FREE-TIER)
#  Copy to .env (in this folder) and fill in. NEVER commit real keys.
#  AutoQA is fully self-contained; it needs no files outside this folder.
# ============================================================

# --- LLM providers (free) ---
# The DECIDE step needs VISION → Gemini only (Groq has no vision models).
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxx       # https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxx       # LiteLLM reads Gemini via this name too
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx           # optional: text-only router fallbacks

# --- Model routing (vision decide-chain; both tiers have separate free quotas) ---
VISION_MODEL=gemini/gemini-3.5-flash          # ~15 RPM / ~1,500 RPD free
VISION_FALLBACK=gemini/gemini-3.1-flash-lite  # separate quota, also vision
TEXT_MODEL=gemini/gemini-3.5-flash            # verify-node auditor (text-only)

# --- Agent limits ---
AGENT_MAX_STEPS=12                 # default per run (UI offers 8/12/20; server cap 25)
ARIA_MAX_CHARS=8000                # page-snapshot truncation for the decide prompt

# --- Browser ---
HEADLESS=true
NAV_TIMEOUT_MS=15000
VIEWPORT_WIDTH=1280
VIEWPORT_HEIGHT=800

# --- Safety ---
ALLOWLIST_EXTRA=                   # comma-separated extra hosts the agent may navigate to
# Known-test-site + test-credential guards have safe defaults in config.py;
# override only if you know what you're doing:
# KNOWN_TEST_HOSTS=www.saucedemo.com,the-internet.herokuapp.com,localhost,127.0.0.1
# TEST_CREDENTIALS=secret_sauce,SuperSecretPassword!

# --- Observability: Langfuse (optional; blank = disabled) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- API ---
AUTOQA_API_PORT=8003
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Persistence ---
AGENT_DB=autoqa.db                 # SQLite: run history + LangGraph checkpoints (relative to backend/)
RUNS_DIR=runs                      # per-run screenshot folders (gitignored)
RUNS_KEEP=50                       # startup sweep keeps the newest N run folders
